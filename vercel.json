{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/06_BRAND_AND_HUB/03_HUB_SITE/index.html" },
    { "source": "/party-board", "destination": "/06_BRAND_AND_HUB/03_HUB_SITE/party-board.html" },
    { "source": "/party-board.html", "destination": "/06_BRAND_AND_HUB/03_HUB_SITE/party-board.html" },
    { "source": "/assets/(.*)", "destination": "/06_BRAND_AND_HUB/03_HUB_SITE/assets/$1" },
    { "source": "/styles.css", "destination": "/06_BRAND_AND_HUB/03_HUB_SITE/styles.css" },
    { "source": "/app.js", "destination": "/06_BRAND_AND_HUB/03_HUB_SITE/app.js" },
    { "source": "/depot-data.js", "destination": "/06_BRAND_AND_HUB/03_HUB_SITE/depot-data.js" },
    { "source": "/party-board.css", "destination": "/06_BRAND_AND_HUB/03_HUB_SITE/party-board.css" },
    { "source": "/party-board.js", "destination": "/06_BRAND_AND_HUB/03_HUB_SITE/party-board.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*).(glb|gltf|png|jpg|jpeg|webp|mp3)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
