{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/party-board", "destination": "/party-board.html" },
    { "source": "/06_BRAND_AND_HUB/03_HUB_SITE", "destination": "/06_BRAND_AND_HUB/03_HUB_SITE/index.html" },
    { "source": "/06_BRAND_AND_HUB/03_HUB_SITE/", "destination": "/06_BRAND_AND_HUB/03_HUB_SITE/index.html" },
    { "source": "/06_BRAND_AND_HUB/03_HUB_SITE/party-board", "destination": "/06_BRAND_AND_HUB/03_HUB_SITE/party-board.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*).(glb|gltf|png|jpg|jpeg|webp|mp3)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
